{
  "expo": {
    "name": "elderconnect",
    "slug": "elderconnect",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/elderconnect-logo.png",
    "scheme": "elderconnect",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/elderconnect-logo.png"
      
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.elderconnect"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/elderconnect-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/elderconnect-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "DEV_API_PORT": "5000",
      "DEV_API_IP": "http://127.0.0.1:5000",
      "TUNNEL_URL": "https://vesical-superloyally-reese.ngrok-free.dev",
      "router": {},
      "eas": {
        "projectId": "4e7ae914-c7f8-49b2-95c3-a63e221d218a"
      }
    }
  }
}
